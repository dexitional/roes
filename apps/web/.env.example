DATABASE_URL="mysql://root:your_password_here@localhost:3306/roes"
# Signs sign-in sessions (at least 32 characters).
SESSION_SECRET=
APP_URL=http://localhost:3020

# Google sign-in for customers. Register {APP_URL}/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: /api/auth/dev?email=... signs in without Google when the keys above are empty.
DEV_LOGIN=true

# SMS notifications via SMSOnlineGH (copied from capevars). The sender ID set in Admin > Settings must be registered there.
SMSONLINEGH_API_KEY=
# Development only: log SMS instead of sending when the key above is empty.
SMS_SIMULATE=false

# Paystack (optional). Leave empty: orders are paid by MoMo to the number set in Admin > Settings.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Local file storage for uploads and imported photos (defaults to apps/web/storage).
STORAGE_DIR=
IMAGE_CACHE_DIR=
# Optional CDN origin in front of /files and /img.
CDN_URL=
